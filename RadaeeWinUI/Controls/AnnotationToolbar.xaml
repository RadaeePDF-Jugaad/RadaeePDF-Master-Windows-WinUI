<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="RadaeeWinUI.Controls.AnnotationToolbar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- Edit mode command bar: replaces the main command bar while an annotation tool is active,
         the user confirms (Done) or discards (Cancel) everything added in this session. -->
    <CommandBar DefaultLabelPosition="Right" IsDynamicOverflowEnabled="False" VerticalContentAlignment="Center">
        <CommandBar.Content>
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="16,0,0,0" Height="48">
                <FontIcon x:Name="ToolIcon" FontSize="16" VerticalAlignment="Center"/>
                <TextBlock x:Name="ToolNameText" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock x:Name="ToolHintText"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </CommandBar.Content>

        <AppBarButton x:Name="ColorButton" Label="Color" ToolTipService.ToolTip="Annotation color">
            <AppBarButton.Icon>
                <FontIcon x:Name="ColorSwatch" Glyph="&#xE91F;" Foreground="#FFFF0000"/>
            </AppBarButton.Icon>
            <AppBarButton.Flyout>
                <MenuFlyout x:Name="ColorMenu" Placement="Bottom">
                    <RadioMenuFlyoutItem Text="Red" Tag="#FFFF0000" GroupName="AnnotColor" IsChecked="True" Click="ColorItem_Click">
                        <RadioMenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE91F;" Foreground="#FFFF0000"/>
                        </RadioMenuFlyoutItem.Icon>
                    </RadioMenuFlyoutItem>
                    <RadioMenuFlyoutItem Text="Blue" Tag="#FF0000FF" GroupName="AnnotColor" Click="ColorItem_Click">
                        <RadioMenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE91F;" Foreground="#FF0000FF"/>
                        </RadioMenuFlyoutItem.Icon>
                    </RadioMenuFlyoutItem>
                    <RadioMenuFlyoutItem Text="Green" Tag="#FF00FF00" GroupName="AnnotColor" Click="ColorItem_Click">
                        <RadioMenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE91F;" Foreground="#FF00FF00"/>
                        </RadioMenuFlyoutItem.Icon>
                    </RadioMenuFlyoutItem>
                    <RadioMenuFlyoutItem Text="Yellow" Tag="#FFFFFF00" GroupName="AnnotColor" Click="ColorItem_Click">
                        <RadioMenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE91F;" Foreground="#FFFFFF00"/>
                        </RadioMenuFlyoutItem.Icon>
                    </RadioMenuFlyoutItem>
                    <RadioMenuFlyoutItem Text="Black" Tag="#FF000000" GroupName="AnnotColor" Click="ColorItem_Click">
                        <RadioMenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE91F;" Foreground="#FF000000"/>
                        </RadioMenuFlyoutItem.Icon>
                    </RadioMenuFlyoutItem>
                </MenuFlyout>
            </AppBarButton.Flyout>
        </AppBarButton>

        <!-- Text selection actions, enabled once some text is selected (same options as DlgMarkup in the UWP reader). -->
        <AppBarSeparator x:Name="TextActionsSeparator"/>
        <AppBarButton x:Name="CopyTextButton" Icon="Copy" Label="Copy" Click="CopyText_Click" ToolTipService.ToolTip="Copy the selected text"/>
        <AppBarButton x:Name="HighlightButton" Label="Highlight" Tag="Highlight" Click="TextMarkup_Click" ToolTipService.ToolTip="Highlight the selected text">
            <AppBarButton.Icon>
                <FontIcon Glyph="&#xE7E6;"/>
            </AppBarButton.Icon>
        </AppBarButton>
        <AppBarButton x:Name="UnderlineButton" Label="Underline" Tag="Underline" Click="TextMarkup_Click" ToolTipService.ToolTip="Underline the selected text">
            <AppBarButton.Icon>
                <FontIcon Glyph="&#xE8DC;"/>
            </AppBarButton.Icon>
        </AppBarButton>
        <AppBarButton x:Name="StrikeoutButton" Label="Strikeout" Tag="Strikeout" Click="TextMarkup_Click" ToolTipService.ToolTip="Strike out the selected text">
            <AppBarButton.Icon>
                <FontIcon Glyph="&#xEDE0;"/>
            </AppBarButton.Icon>
        </AppBarButton>
        <AppBarButton x:Name="SquigglyButton" Label="Squiggly" Tag="Squiggly" Click="TextMarkup_Click" ToolTipService.ToolTip="Add a squiggly underline to the selected text">
            <AppBarButton.Icon>
                <FontIcon Glyph="&#xE8D2;"/>
            </AppBarButton.Icon>
        </AppBarButton>

        <AppBarElementContainer x:Name="StrokeWidthPanel" VerticalContentAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="8" Padding="8,0">
                <TextBlock Text="Width" VerticalAlignment="Center"/>
                <Slider x:Name="StrokeWidthSlider"
                        Minimum="1" Maximum="10" StepFrequency="1"
                        Width="120"
                        VerticalAlignment="Center"
                        ValueChanged="StrokeWidthSlider_ValueChanged"/>
                <TextBlock x:Name="StrokeWidthText" Width="20" VerticalAlignment="Center"/>
            </StackPanel>
        </AppBarElementContainer>

        <AppBarSeparator x:Name="PropertySeparator"/>

        <AppBarButton Icon="Cancel" Label="Cancel" Click="Cancel_Click" ToolTipService.ToolTip="Discard the annotations added in this session (Esc)">
            <AppBarButton.KeyboardAccelerators>
                <KeyboardAccelerator Key="Escape"/>
            </AppBarButton.KeyboardAccelerators>
        </AppBarButton>
        <AppBarButton Icon="Accept" Label="Done" Click="Done_Click" ToolTipService.ToolTip="Keep the annotations added in this session"/>
    </CommandBar>
</UserControl>

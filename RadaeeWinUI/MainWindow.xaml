<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="RadaeeWinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:RadaeeWinUI"
    xmlns:controls="using:RadaeeWinUI.Controls"
    xmlns:pdfview="using:RadaeeWinUI.Controls.PDFView"
    xmlns:models="using:RadaeeWinUI.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Radaee Document Viewer">



    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Main command bar: features are grouped into drop-down menus (same layout as the UWP reader). -->
        <CommandBar x:Name="MainCommandBar" Grid.Row="0" DefaultLabelPosition="Right" VerticalContentAlignment="Center">
            <CommandBar.Content>
                <TextBlock x:Name="DocumentNameText"
                           Margin="16,0,0,0"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
            </CommandBar.Content>

            <AppBarButton Icon="OpenFile" Label="Open" Click="OpenDocument_Click">
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Key="O" Modifiers="Control"/>
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarSeparator x:Name="DocumentCommandsSeparator"/>

            <AppBarButton x:Name="BtnView" Icon="View" Label="View">
                <AppBarButton.Flyout>
                    <MenuFlyout Placement="Bottom">
                        <RadioMenuFlyoutItem x:Name="ViewModeSinglePage" Text="Single Page" Tag="SinglePage" GroupName="ViewMode" Click="ViewMode_Click"/>
                        <RadioMenuFlyoutItem x:Name="ViewModeVertical" Text="Vertical Continuous" Tag="VerticalContinuous" GroupName="ViewMode" Click="ViewMode_Click"/>
                        <RadioMenuFlyoutItem x:Name="ViewModeHorizontal" Text="Horizontal Continuous" Tag="HorizontalContinuous" GroupName="ViewMode" Click="ViewMode_Click"/>
                        <RadioMenuFlyoutItem x:Name="ViewModeDualPage" Text="Dual Page" Tag="DualPageContinuous" GroupName="ViewMode" Click="ViewMode_Click"/>
                        <MenuFlyoutSeparator/>
                        <MenuFlyoutItem Icon="ZoomIn" Text="Zoom In" Click="ZoomIn_Click"/>
                        <MenuFlyoutItem Icon="ZoomOut" Text="Zoom Out" Click="ZoomOut_Click"/>
                        <MenuFlyoutItem Text="Fit Width" Click="FitWidth_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE9A6;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </AppBarButton.Flyout>
            </AppBarButton>

            <AppBarButton x:Name="BtnTools" Icon="Repair" Label="Tools">
                <AppBarButton.Flyout>
                    <MenuFlyout Placement="Bottom">
                        <MenuFlyoutItem x:Name="MenuSearch" Icon="Find" Text="Search" Click="Search_Click">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Key="F" Modifiers="Control"/>
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="MenuOutline" Text="Outline" Click="Outline_Click" Visibility="Collapsed">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE8FD;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="MenuAttachment" Icon="Attach" Text="Attachments" Click="Attachment_Click" Visibility="Collapsed"/>
                    </MenuFlyout>
                </AppBarButton.Flyout>
            </AppBarButton>

            <AppBarButton x:Name="BtnAnnotations" Icon="Edit" Label="Annotations">
                <AppBarButton.Flyout>
                    <MenuFlyout Placement="Bottom">
                        <MenuFlyoutItem Text="Ink" Tag="Ink" Click="AnnotationTool_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE76D;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Note" Tag="TextNote" Click="AnnotationTool_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE70B;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Line" Tag="Line" Click="AnnotationTool_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE738;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Rectangle" Tag="Rectangle" Click="AnnotationTool_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE739;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Ellipse" Tag="Ellipse" Click="AnnotationTool_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xEA3A;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator/>
                        <MenuFlyoutItem Text="Text Selection" Tag="Select" Click="AnnotationTool_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE8B3;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Highlight" Tag="Highlight" Click="AnnotationTool_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE7E6;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Underline" Tag="Underline" Click="AnnotationTool_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE8DC;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Strikeout" Tag="Strikeout" Click="AnnotationTool_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xEDE0;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </AppBarButton.Flyout>
            </AppBarButton>

            <AppBarButton x:Name="BtnFields" Icon="Page2" Label="Fields">
                <AppBarButton.Flyout>
                    <MenuFlyout Placement="Bottom">
                        <MenuFlyoutItem Text="Edit Box" Tag="EditBox" Click="AnnotationTool_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE8AC;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </AppBarButton.Flyout>
            </AppBarButton>
        </CommandBar>

        <!-- Replaces the main command bar while an annotation tool is active. -->
        <controls:AnnotationToolbar x:Name="AnnotationToolbar" Grid.Row="0" Visibility="Collapsed"/>
        <controls:SearchToolbar x:Name="SearchToolbar" Grid.Row="1" Visibility="Collapsed"/>

        <Grid Grid.Row="2">
            <TextBlock x:Name="EmptyMessage"
                       Text="Open a PDF or DOCX document to start viewing"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="20"
                       Foreground="Gray"/>

            <ContentControl x:Name="PDFViewContainer"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            Visibility="Collapsed"/>

            <ContentControl x:Name="DOCXViewContainer"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            Visibility="Collapsed"/>
        </Grid>

        <Grid Grid.Row="3" Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}" Padding="10,5">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
                <Button Content="Previous" Click="PreviousPage_Click">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Left"/>
                    </Button.KeyboardAccelerators>
                </Button>
                <Button Content="Next" Click="NextPage_Click">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Right"/>
                    </Button.KeyboardAccelerators>
                </Button>
                <Border BorderBrush="{ThemeResource SystemControlForegroundBaseMediumBrush}" 
                        BorderThickness="1" 
                        CornerRadius="4" 
                        Padding="10,5" 
                        Margin="10,0">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock Text="Page:" VerticalAlignment="Center"/>
                        <TextBlock x:Name="PageNumberText" 
                                   Text="0"
                                   VerticalAlignment="Center" 
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="/" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TotalPagesText" 
                                   Text="0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border BorderBrush="{ThemeResource SystemControlForegroundBaseMediumBrush}" 
                        BorderThickness="1" 
                        CornerRadius="4" 
                        Padding="10,5">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock Text="Zoom:" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ZoomLevelText" 
                                   Text="100%"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Window>

